# Server
NODE_ENV=development
PORT=5000
# Comma-separated CORS whitelist. The storefront and the admin panel deploy as two separate
# front-ends on two different domains, so both belong here (plus any preview URL that needs
# to talk to this API). The first entry is treated as the canonical client URL.
CLIENT_URL=http://localhost:3000,http://localhost:3001
# Public base URL the server itself is reachable at (used to build links like
# credential-download URLs that are sent in emails). Defaults to http://localhost:<PORT>/api.
API_URL=http://localhost:5000/api

# MongoDB
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"
MONGODB_DB_NAME=accvendor
# JWT
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Cookies
COOKIE_DOMAIN=localhost
# Session cookies. Defaults to `none` in production (API and storefront sit on different
# domains, so auth requests are cross-site and Lax cookies would never be sent) and `lax`
# in development. Set to `lax` only if you serve both from a single domain.
COOKIE_SAMESITE=

# Email delivery. Two transports; Resend wins if both are set. If neither is configured the
# server logs emails to the console instead (dev-friendly stub) and still boots.
#
# RESEND (recommended) — an HTTPS API on port 443. Prefer this on any host that blocks
# outbound SMTP; Render's free tier blocks ports 25/465/587, which makes a plain SMTP
# transport hang there until it times out. Get a key at resend.com/api-keys.
# Until you verify a domain in Resend, EMAIL_FROM must stay "Accvendor <onboarding@resend.dev>"
# and Resend will ONLY deliver to the address that owns the API key — verify a domain before
# expecting real customers to receive anything.
RESEND_API_KEY=replace_me

# SMTP (Gmail, Brevo) — fallback, used only when RESEND_API_KEY is unset.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=your Gmail address, SMTP_PASS=a Gmail
# App Password (not your normal password — generate one at myaccount.google.com/apppasswords),
# and EMAIL_FROM should use that same Gmail address or Gmail will reject/rewrite it.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASS=replace_me

# Sender address, shared by both transports.
EMAIL_FROM="Accvendor <onboarding@resend.dev>"

# Absolute, publicly reachable URL of the logo shown inside transactional emails. Mail
# clients cannot resolve a local path or a relative URL, so this must be a real https URL
# or every recipient sees a broken image.
EMAIL_LOGO_URL=https://accvendor.vercel.app/logo.png

# OTP / Password reset
OTP_EXPIRES_MINUTES=10
# Server-enforced cooldowns, in seconds. Measured against timestamps stored on the pending
# signup record, so refreshing the page or clearing local storage cannot shorten the wait.
OTP_RESEND_COOLDOWN_SECONDS=5
SIGNUP_COOLDOWN_SECONDS=5
# Wrong-OTP attempts allowed before the pending signup locks for a cooling period.
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_VERIFY_LOCK_MINUTES=15
RESET_TOKEN_EXPIRES_MINUTES=15

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Login lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Rate limiting. The global bucket counts every API call and one page view costs
# several, so it is deliberately generous; the auth/OTP buckets are the tight ones.
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=15
RATE_LIMIT_GLOBAL_MAX=3000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_UPLOAD_MAX=60
RATE_LIMIT_OTP_MAX=10
# Write-side buckets for repeatable customer actions (order create, review, ticket) and a
# ceiling on search, which is read-only and already debounced client-side.
RATE_LIMIT_ORDER_MAX=20
RATE_LIMIT_REVIEW_MAX=10
RATE_LIMIT_TICKET_MAX=15
RATE_LIMIT_SEARCH_MAX=120

# Google Sign-In (optional convenience path) — leave unset to keep it disabled;
# manual email signup works fully without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed script (creates one admin user on `npm run seed`)
SEED_ADMIN_EMAIL=admin@accvendor.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Cloudinary (added in Phase 3 — signed direct-to-browser uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Credential delivery (added in Phase 4) — signs short-lived download URLs so
# credential files are never served from a public, guessable URL.
CREDENTIAL_URL_SECRET=replace_with_a_third_long_random_string
CREDENTIAL_URL_EXPIRES_MINUTES=60

# Subscription expiry cron (added in Phase 4)
EXPIRY_REMINDER_DAYS_BEFORE=3
EXPIRY_CRON_SCHEDULE="0 6 * * *"

# Unpaid order window (Phase C). An order that is created but never paid for is held for
# this many minutes, then expired by the sweep below. Enforced server-side only.
UNPAID_ORDER_WINDOW_MINUTES=60
UNPAID_ORDER_CRON_SCHEDULE="* * * * *"

# Support ticket auto-close (Phase F). A ticket the admin has answered closes automatically
# after this much customer silence.
TICKET_AUTO_CLOSE_HOURS=48
TICKET_AUTO_CLOSE_CRON_SCHEDULE="15 * * * *"

# Shareable 2FA links (Phase G). Encrypts the stored TOTP secret with AES-256-GCM. Set a
# long random value in production — changing it invalidates every existing share link.
TOTP_SHARE_SECRET=replace_with_a_long_random_string
TOTP_SHARE_EXPIRES_HOURS=24

# Community link surfaced in the storefront footer and the admin sidebar. Leave blank to hide.
DISCORD_URL=

# Year shown in the transactional-email footer. Keep it in step with the storefront footer,
# which reads Settings.footer.copyrightYear from the database (Admin → Settings → Footer).
COPYRIGHT_YEAR=2024
